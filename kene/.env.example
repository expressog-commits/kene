# Base SQLite locale (ou chaîne PostgreSQL avec prisma/schema.postgres.prisma)
DATABASE_URL="file:./kene.db"

# Phase 2 : activer le module hôpitaux / lits d'urgences ("true" pour afficher)
NEXT_PUBLIC_ENABLE_HOSPITALS="false"

# Afficher les comptes professionnels de démonstration sur l'écran de connexion
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS="true"

# Mettre à "true" en production pour bloquer POST /api/actions { action: "resetDemo" }
KENE_DISABLE_DEMO_RESET="false"

# Envoi des codes de secours par email (optionnel).
# Sans ces variables, Kéné fonctionne : le code de secours est seulement affiché
# une fois dans l'interface, à la création du compte ou après récupération.
KNOCK_API_KEY=
KNOCK_WORKFLOW_KEY=account-recovery-code
KNOCK_API_URL=https://api.knock.app/v1
